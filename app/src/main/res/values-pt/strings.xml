    <!-- Instructions -->

    <string name="first_heading">COMO USAR O TESTE DE HIV ORAQUICK®, USO PESSOAL</string>
    <string name="sentence_1">VOCÊ PRECISARÁ ESTIMAR A DURAÇÃO DO TESTE</string>
    <string name="sentence_2">A embalagem contém: dispositivos de teste, um suporte para teste e instruções de uso</string>
    <string name="sentence_3">DEIXE O DISPOSITIVO NO TUBO por 20 MINUTOS antes de ler o resultado. NÃO LEIA o resultado após 40 minutos.</string>

    <string name="sentence_6">Remova o dispositivo do tubo, feche o tubo e descarte tudo no lixo.</string>
    <string name="sentence_7">RESULTADO POSITIVO</string>
    <string name="sentence_8">Duas linhas completas, mesmo que fracas, significam que você pode ter HIV e precisa de testes adicionais.</string>
    <string name="sentence_9">Visite um VCT ou centro de saúde próximo o mais rápido possível</string>

    <string name="sentence_12">RESULTADO NEGATIVO</string>
    <string name="sentence_13">UMA LINHA na área “C” e NENHUMA linha na área “T”, seu resultado é negativo, você não tem HIV.&#10;Considere fazer testes regularmente. Se você acha que foi exposto recentemente ao HIV, refaça o teste após três meses.</string>

    <string name="sentence_15">RESULTADO INVÁLIDO</string>
    <string name="sentence_16">Nenhuma linha na área “C” (mesmo que haja uma linha na área “T”), ou se houver uma cor vermelha que impeça a leitura, o teste é inválido e deve ser repetido. Você precisará de um novo kit.&#10;O teste não funcionou corretamente. Visite um VCT ou centro de saúde próximo para testes adicionais.</string>

    <string name="sentence_18">Se você não souber ou tiver dúvidas sobre seu resultado, visite um VCT ou centro de saúde próximo para testes adicionais.</string>
    <string name="sentence_19">RESULTADO INCERTO</string>
    <string name="sentence_20">DESCARTE</string>

    <string name="sentence_21">Seu teste de HIV possui dois compartimentos conectados.</string>
    <string name="sentence_22">Rasgue a embalagem no lado com a ilustração do tubo e remova o tubo.</string>
    <string name="sentence_23">Remova a tampa do tubo. NÃO DERRAME o líquido. NÃO BEBA.</string>
    <string name="sentence_24">Passe o cotonete na gengiva superior uma vez, cobrindo toda a área, depois na gengiva inferior.</string>
    <string name="sentence_25">Insira o dispositivo no tubo até que o cotonete fique submerso no líquido.</string>
    <string name="sentence_26">Abra a embalagem do dispositivo de teste e remova-o. NÃO TOQUE na parte plana com os dedos. NÃO INGIRA o conservante.</string>
    <string name="sentence_27">Não derrame o líquido. Não beba.</string>
    <string name="sentence_28">Coloque o tubo no suporte.</string>

